.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Azure
.azure/

# Node modules (if using JS tooling)
node_modules/

# Python (if using Python tooling)
__pycache__/
*.py[cod]
venv/
.env
